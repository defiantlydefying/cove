generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  hashedPassword String?
  image          String?
  displayName    String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  tasks               Task[]
  routines            Routine[]
  wellnessCheckins    WellnessCheckin[]
  reminders           Reminder[]
  achievements        UserAchievement[]
  streaks             UserStreak[]
  moduleSettings      ModuleSetting[]
  userSettings        UserSettings?
  profile             UserProfile?
  focusSessions       FocusSession[]
  plannerItems        PlannerItem[]
  habits              Habit[]
  weeklyGoals         WeeklyGoal[]
  timeEntries         TimeEntry[]
  communityRoutines   CommunityRoutine[]
  communityHelpfuls   CommunityHelpful[]
  communityReports    CommunityReport[]
  dailyActivities     DailyActivity[]
  inboxItems          InboxItem[]
  vents               Vent[]
  ventComments        VentComment[]
  ventReports         VentReport[]
  avatarKey           String?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Task {
  id             String    @id @default(cuid())
  userId         String
  title          String
  description    String?
  completed      Boolean   @default(false)
  completedAt    DateTime?
  deadline       DateTime?
  priority       String    @default("medium")
  energyLevel    String?
  parentId       String?
  sortOrder      Int       @default(0)
  isRecurring    Boolean   @default(false)
  recurrenceRule String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  status          String    @default("active")
  stage           String    @default("inbox")
  scheduledDate   DateTime? @db.Date
  completedReason String?
  deferredUntil   DateTime? @db.Date

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        Task?          @relation("SubTasks", fields: [parentId], references: [id])
  subtasks      Task[]         @relation("SubTasks")
  focusSessions FocusSession[]
  plannerItems  PlannerItem[]
  plannerLinks  PlannerItem[]  @relation("PlannerLinks")
  timeEntries   TimeEntry[]

  @@index([userId, stage])
  @@index([userId, scheduledDate])
}

model Routine {
  id            String        @id @default(cuid())
  userId        String
  name          String
  schedule      String?
  isActive      Boolean       @default(true)
  sortOrder     Int           @default(0)
  startTime     String?
  showTimes     Boolean       @default(false)
  showDurations Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps RoutineStep[]
  logs  RoutineLog[]
}

model RoutineStep {
  id              String  @id @default(cuid())
  routineId       String
  title           String
  sortOrder       Int     @default(0)
  durationMinutes Int?

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
}

model RoutineLog {
  id             String   @id @default(cuid())
  routineId      String
  date           DateTime @db.Date
  completedSteps String[]
  createdAt      DateTime @default(now())

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, date])
}

model WellnessCheckin {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  mood      Int?
  energy    Int?
  sleep     Int?
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Reminder {
  id              String    @id @default(cuid())
  userId          String
  title           String
  message         String?
  type            String    @default("custom")
  schedule        String?
  enabled         Boolean   @default(true)
  snoozedUntil    DateTime?
  scheduledTime   String?
  intervalMinutes Int?
  activeDays      String    @default("0,1,2,3,4,5,6")
  presetKey       String?
  soundEnabled    Boolean   @default(true)
  notifyEnabled   Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  description String
  xpReward    Int    @default(0)

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model UserStreak {
  id            String    @id @default(cuid())
  userId        String
  type          String
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastActiveAt  DateTime?
  pausedAt      DateTime?
  totalXp       Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model ModuleSetting {
  id       String  @id @default(cuid())
  userId   String
  moduleId String
  enabled  Boolean @default(true)
  config   Json    @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

model UserProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  age          Int?
  conditions   String[] // e.g., ["ADHD", "Autism", "Anxiety", "Dyslexia"]
  medications  String[] // e.g., ["Adderall", "Lexapro"]
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id             String  @id @default(cuid())
  userId         String  @unique
  theme          String  @default("light")
  accentColor    String  @default("#4F7CAC")
  density        String  @default("comfortable")
  animationsOn   Boolean @default(true)
  soundsOn       Boolean @default(true)
  fontSize       String  @default("medium")
  tone           String  @default("encouraging")
  sidebarVisible    Boolean @default(true)
  companionType     String  @default("fox")
  companionChosen   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FocusSession {
  id          String   @id @default(cuid())
  userId      String
  label       String?
  taskId      String?
  durationMin Int
  sessionType String   @default("focus")
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id])

  @@index([userId, completedAt])
}

model PlannerItem {
  id        String   @id @default(cuid())
  userId    String
  title     String
  date      DateTime @db.Date
  zone      String   @default("must")
  sortOrder Int      @default(0)
  startTime String?
  endTime   String?
  completed Boolean  @default(false)
  taskId       String?
  linkedTaskId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task       Task? @relation(fields: [taskId], references: [id])
  linkedTask Task? @relation("PlannerLinks", fields: [linkedTaskId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model Habit {
  id            String        @id @default(cuid())
  userId        String
  title         String
  currentStreak Int           @default(0)
  longestStreak Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checks      HabitCheck[]
  linkedGoals WeeklyGoal[]

  @@index([userId])
}

model HabitCheck {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

model WeeklyGoal {
  id            String   @id @default(cuid())
  userId        String
  title         String
  targetCount   Int
  currentCount  Int      @default(0)
  weekStart     DateTime @db.Date
  linkedHabitId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedHabit Habit? @relation(fields: [linkedHabitId], references: [id])

  @@index([userId, weekStart])
}

model TimeEntry {
  id          String   @id @default(cuid())
  userId      String
  label       String
  durationMin Int
  date        DateTime @db.Date
  taskId      String?
  createdAt   DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id])

  @@index([userId, date])
}

model CommunityRoutine {
  id            String   @id @default(cuid())
  authorId      String
  displayName   String
  authorNote    String?
  name          String
  description   String?
  startTime     String?
  showTimes     Boolean  @default(false)
  showDurations Boolean  @default(true)
  tags          String[]
  helpfulCount  Int      @default(0)
  hidden        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author   User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  steps    CommunityRoutineStep[]
  helpfuls CommunityHelpful[]
  reports  CommunityReport[]

  @@index([authorId])
}

model CommunityRoutineStep {
  id                 String @id @default(cuid())
  communityRoutineId String
  title              String
  durationMinutes    Int?
  sortOrder          Int    @default(0)

  communityRoutine CommunityRoutine @relation(fields: [communityRoutineId], references: [id], onDelete: Cascade)
}

model CommunityHelpful {
  id                 String   @id @default(cuid())
  userId             String
  communityRoutineId String
  createdAt          DateTime @default(now())

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  communityRoutine CommunityRoutine @relation(fields: [communityRoutineId], references: [id], onDelete: Cascade)

  @@unique([userId, communityRoutineId])
}

model CommunityReport {
  id                 String   @id @default(cuid())
  userId             String
  communityRoutineId String
  reason             String
  createdAt          DateTime @default(now())

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  communityRoutine CommunityRoutine @relation(fields: [communityRoutineId], references: [id], onDelete: Cascade)
}

model DailyActivity {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime @db.Date
  activityTypes  String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model InboxItem {
  id          String   @id @default(cuid())
  userId      String
  content     String
  source      String   @default("text")
  status      String   @default("unprocessed")
  convertedTo String?
  convertedId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model CommunityAvatar {
  id              String @id @default(cuid())
  key             String @unique
  label           String
  category        String @default("starter")
  unlockType      String @default("default")
  unlockThreshold Int?
}

model Vent {
  id                String   @id @default(cuid())
  authorId          String
  body              String
  lifespan          String
  expiresAt         DateTime
  contactPreference String   @default("both")
  reportCount       Int      @default(0)
  hidden            Boolean  @default(false)
  createdAt         DateTime @default(now())

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments VentComment[]
  reports  VentReport[]

  @@index([expiresAt])
  @@index([authorId])
}

model VentComment {
  id        String   @id @default(cuid())
  ventId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  vent   Vent @relation(fields: [ventId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ventId])
}

model VentReport {
  id        String   @id @default(cuid())
  ventId    String
  userId    String
  reason    String
  createdAt DateTime @default(now())

  vent Vent @relation(fields: [ventId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ventId])
}
